{
  "name": "kanto-team-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Pokémon Red/Blue (Gen 1) team optimizer for the original 151",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc",
    "data:fetch": "node scripts/fetch-pokeapi.mjs",
    "data:build": "node scripts/build-data.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "pokemon-showdown": "^0.11.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
